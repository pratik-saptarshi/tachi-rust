{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tachi.example/schemas/ci-run-aggregate.schema.json",
  "title": "Tachi local CI aggregate result",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "cache_context", "retention", "started_ms", "finished_ms", "total_duration_ms", "unit_count", "passed", "failed", "timed_out", "cancelled", "stages", "cleanup", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["local-full", "local-route-equivalent"]},
    "cache_context": {"enum": ["cold", "warm", "unknown"]},
    "retention": {"enum": ["ephemeral", "retain"]},
    "started_ms": {"type": "integer", "minimum": 0},
    "finished_ms": {"type": "integer", "minimum": 0},
    "total_duration_ms": {"type": "integer", "minimum": 0},
    "unit_count": {"type": "integer", "minimum": 0},
    "passed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "timed_out": {"type": "integer", "minimum": 0},
    "cancelled": {"type": "integer", "minimum": 0},
    "stages": {"type": "array", "items": {"type": "object"}},
    "cleanup": {"type": "object", "required": ["verified", "mode"], "properties": {"verified": {"type": "boolean"}, "mode": {"enum": ["ephemeral", "retain"]}}, "additionalProperties": false},
    "results": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
