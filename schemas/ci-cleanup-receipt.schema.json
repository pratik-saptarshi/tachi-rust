{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tachi.example/schemas/ci-cleanup-receipt.schema.json",
  "title": "Tachi local CI cleanup receipt",
  "type": "object",
  "required": ["schema_version", "run_id", "retention", "verified"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "retention": {"const": "ephemeral"},
    "verified": {"type": "boolean"}
  },
  "additionalProperties": false
}
